# Public Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only Supabase configuration
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_DATABASE_URL=postgresql://postgres.project:password@host:6543/postgres

# Server-only OpenAI configuration
OPENAI_API_KEY=sk-project-replace_me
OPENAI_MODEL_TRANSLATION=gpt-5.6-terra
OPENAI_MODEL_OCR=gpt-5.6-terra

# Application URLs and optional platform administrator bootstrap list
APP_URL=http://localhost:3000
PLATFORM_ADMIN_EMAILS=owner@example.com

# Optional abuse-control salt. Use a long random value in production.
RATE_LIMIT_SALT=replace-with-at-least-32-random-characters

# Local-only credential used by the shadcn CLI to access React Bits Pro.
# Do not expose this variable to the browser or commit its real value.
REACTBITS_LICENSE_KEY=replace-with-your-react-bits-license-key
