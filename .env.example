# Public Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only Supabase configuration
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_DATABASE_URL=postgresql://postgres.project:password@host:6543/postgres

# Server-only AI provider configuration. OpenRouter is the temporary default.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENAI_MODEL_TRANSLATION=stealth/ox-alpha
OPENAI_MODEL_OCR=stealth/ox-alpha

# To use OpenAI directly instead, set AI_PROVIDER=openai, provide this key,
# and use model IDs without the `openai/` OpenRouter prefix.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Application URLs and optional platform administrator bootstrap list
APP_URL=http://localhost:3000
PLATFORM_ADMIN_EMAILS=owner@example.com

# Optional abuse-control salt. Use a long random value in production.
RATE_LIMIT_SALT=replace-with-at-least-32-random-characters

# Local-only credential used by the shadcn CLI to access React Bits Pro.
# Do not expose this variable to the browser or commit its real value.
REACTBITS_LICENSE_KEY=replace-with-your-react-bits-license-key

# Noqoody payment gateway (Qatar). Leave unset until the merchant account and
# verified API credentials are provisioned; the webhook returns 503 while
# unset and checkout stays disabled.
NOQOODY_WEBHOOK_SECRET=replace-with-noqoody-webhook-hmac-secret

# Flip to true ONLY after the Noqoody gateway is connected and verified;
# while false, paid plans cannot be self-serve activated (admins can still
# assign them) and checkout returns 402 checkout_unavailable.
CHECKOUT_ENABLED=false
